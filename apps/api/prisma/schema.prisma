// Esquema base de Comercia: identidad y plataforma configurable.
// Los módulos funcionales se agregan como extensiones independientes.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id                    Int                       @id @default(autoincrement())
  nombre                String                    @unique
  dbName                String?                   @map("db_name")
  empresaId             Int?                      @map("empresas_id")
  padre                 Empresa?                  @relation("EmpresaJerarquia", fields: [empresaId], references: [id])
  hijas                 Empresa[]                 @relation("EmpresaJerarquia")
  usuarios              Usuario[]
  roles                 Rol[]
  clientesCampo         ClienteCampo[]
  tareasCampo           TareaCampo[]
  eventosUcheck         IntegracionUcheckEvento[]
  modulos               EmpresaModulo[]
  paginas               EmpresaPagina[]
  notificacionesCampo   NotificacionCampo[]
  novedadesCampo        NovedadCampo[]
  avisosCampo           AvisoCampo[]
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@map("empresas")
}

model Conexion {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique
  servernode   String?
  userDb       String?      @map("user_db")
  passwordDb   String?      @map("password_db")
  serviceLayer String?      @map("service_layer")
  versionTls   String?      @map("version_tls")
  ejecutables  Ejecutable[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("conexiones")
}

enum TipoEjecutable {
  PROCEDURE
  FUNCTION
  VIEW
  QUERY
}

enum MotorBd {
  POSTGRESQL
  SAP_HANA
  ORACLE
  MYSQL
  SQLSERVER
}

model Modulo {
  id        Int             @id @default(autoincrement())
  nombre    String
  ruta      String          @unique
  icono     String?
  orden     Int             @default(0)
  activo    Boolean         @default(true)
  paginas   Pagina[]
  empresas  EmpresaModulo[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("modulos")
}

model Pagina {
  id          Int             @id @default(autoincrement())
  moduloId    Int             @map("modulo_id")
  modulo      Modulo          @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  nombre      String
  ruta        String
  icono       String?
  orden       Int             @default(0)
  activo      Boolean         @default(true)
  ejecutables Ejecutable[]
  empresas    EmpresaPagina[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")

  @@unique([moduloId, ruta])
  @@map("paginas")
}

model Ejecutable {
  id         Int            @id @default(autoincrement())
  paginaId   Int            @map("pagina_id")
  pagina     Pagina         @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  nombre     String
  tipo       TipoEjecutable
  motor      MotorBd        @default(POSTGRESQL)
  conexionId Int?           @map("conexion_id")
  conexion   Conexion?      @relation(fields: [conexionId], references: [id])
  sentencia  String
  orden      Int            @default(0)
  activo     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  @@map("ejecutables")
}

model EmpresaModulo {
  id              Int      @id @default(autoincrement())
  empresaId       Int      @map("empresa_id")
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  moduloId        Int      @map("modulo_id")
  modulo          Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  todasLasPaginas Boolean  @default(true) @map("todas_las_paginas")
  rolIds          Int[]    @default([]) @map("rol_ids")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([empresaId, moduloId])
  @@map("empresa_modulos")
}

model EmpresaPagina {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  paginaId  Int      @map("pagina_id")
  pagina    Pagina   @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  rolIds    Int[]    @default([]) @map("rol_ids")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([empresaId, paginaId])
  @@map("empresa_paginas")
}

model Rol {
  id          Int       @id @default(autoincrement())
  descripcion String
  empresaId   Int       @map("empresa_id")
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  rolId       Int?      @map("roles_id")
  padre       Rol?      @relation("RolJerarquia", fields: [rolId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  hijos       Rol[]     @relation("RolJerarquia")
  usuarios    Usuario[]

  @@unique([empresaId, descripcion])
  @@unique([id, empresaId])
  @@map("roles")
}

model Usuario {
  id                        Int                       @id @default(autoincrement())
  empresaId                 Int                       @map("empresa_id")
  empresa                   Empresa                   @relation(fields: [empresaId], references: [id])
  nombre                    String
  apellido                  String
  correo                    String                    @unique
  nombreLogin               String                    @unique @map("nombre_login")
  passwordHash              String                    @map("password_hash")
  ruc                       String                    @unique
  celular                   String
  rolId                     Int?                      @map("rol_id")
  rol                       Rol?                      @relation(fields: [rolId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  superiorId                Int?                      @map("superior_id")
  superior                  Usuario?                  @relation("UsuarioJerarquia", fields: [superiorId], references: [id])
  subordinados              Usuario[]                 @relation("UsuarioJerarquia")
  asignacionesCampo         AsignacionCampo[]         @relation("CampoTitular")
  backupsCampo              BackupCampo[]             @relation("CampoBackup")
  visitasCampo              VisitaCampo[]
  eventosUcheck             IntegracionUcheckEvento[]
  comentariosTarea          ComentarioTareaCampo[]
  fotosTarea                FotoTareaCampo[]
  notificacionesRecibidas   NotificacionCampo[]       @relation("NotificacionesRecibidas")
  notificacionesEnviadas    NotificacionCampo[]       @relation("NotificacionesEnviadas")
  novedadesReportadas       NovedadCampo[]            @relation("NovedadesReportadas")
  novedadesCerradas         NovedadCampo[]            @relation("NovedadesCerradas")
  avisosEnviados            AvisoCampo[]              @relation("AvisosEnviados")
  avisosRecibidos           AvisoCampo[]              @relation("AvisosRecibidos")
  lecturasAvisos            AvisoLecturaCampo[]
  esSuperadmin              Boolean                   @default(false) @map("es_superadmin")
  isActive                  Boolean                   @default(true) @map("is_active")
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@map("usuarios")
}

model ClienteCampo {
  id        Int          @id @default(autoincrement())
  empresaId Int          @map("empresa_id")
  empresa   Empresa      @relation(fields: [empresaId], references: [id])
  nombre    String       @db.VarChar(120)
  ruc       String       @default("") @db.VarChar(30)
  contacto  String       @default("") @db.VarChar(120)
  telefono  String       @default("") @db.VarChar(40)
  logoUrl   String?      @map("logo_url") @db.VarChar(500)
  activo    Boolean      @default(true)
  locales   LocalCampo[]

  @@index([empresaId, activo, nombre])
  @@map("campo_clientes")
}

model LocalCampo {
  id            Int                       @id @default(autoincrement())
  clienteId     Int                       @map("cliente_id")
  cliente       ClienteCampo              @relation(fields: [clienteId], references: [id])
  nombre        String                    @db.VarChar(120)
  direccion     String                    @default("") @db.VarChar(250)
  contacto      String                    @default("") @db.VarChar(120)
  telefono      String                    @default("") @db.VarChar(40)
  latitud       Float
  longitud      Float
  radioMetros   Int                       @default(100) @map("radio_metros")
  zonaHoraria   String                    @default("America/Asuncion") @map("zona_horaria") @db.VarChar(80)
  notas         String                    @default("") @db.VarChar(1000)
  activo        Boolean                   @default(true)
  horarios      HorarioCampo[]
  asignaciones  AsignacionCampo[]
  tareas        TareaLocalCampo[]
  visitas       VisitaCampo[]
  novedades     NovedadCampo[]
  eventosUcheck IntegracionUcheckEvento[]

  @@index([clienteId, activo])
  @@map("campo_locales")
}

enum FrecuenciaCampo {
  DIARIA
  SEMANAL
  MENSUAL
}

model HorarioCampo {
  id            Int                       @id @default(autoincrement())
  localId       Int                       @map("local_id")
  local         LocalCampo                @relation(fields: [localId], references: [id])
  frecuencia    FrecuenciaCampo           @default(SEMANAL)
  intervalo     Int                       @default(1)
  diasSemana    Int[]                     @default([]) @map("dias_semana")
  diasMes       Int[]                     @default([]) @map("dias_mes")
  fechaDesde    DateTime                  @map("fecha_desde") @db.Date
  fechaHasta    DateTime?                 @map("fecha_hasta") @db.Date
  entrada       String                    @db.VarChar(5)
  salida        String                    @db.VarChar(5)
  activo        Boolean                   @default(true)
  visitas       VisitaCampo[]
  eventosUcheck IntegracionUcheckEvento[]

  @@index([localId, activo])
  @@map("campo_horarios")
}

model AsignacionCampo {
  id            Int                       @id @default(autoincrement())
  localId       Int                       @map("local_id")
  local         LocalCampo                @relation(fields: [localId], references: [id])
  usuarioId     Int                       @map("usuario_id")
  usuario       Usuario                   @relation("CampoTitular", fields: [usuarioId], references: [id])
  fechaDesde    DateTime                  @map("fecha_desde") @db.Date
  fechaHasta    DateTime?                 @map("fecha_hasta") @db.Date
  activo        Boolean                   @default(true)
  backups       BackupCampo[]
  visitas       VisitaCampo[]
  eventosUcheck IntegracionUcheckEvento[]

  @@index([usuarioId, activo, fechaDesde])
  @@index([localId, activo])
  @@map("campo_asignaciones")
}

model BackupCampo {
  id           Int             @id @default(autoincrement())
  asignacionId Int             @map("asignacion_id")
  asignacion   AsignacionCampo @relation(fields: [asignacionId], references: [id])
  usuarioId    Int             @map("usuario_id")
  usuario      Usuario         @relation("CampoBackup", fields: [usuarioId], references: [id])
  fechaDesde   DateTime        @map("fecha_desde") @db.Date
  fechaHasta   DateTime        @map("fecha_hasta") @db.Date
  motivo       String          @db.VarChar(250)
  activo       Boolean         @default(true)

  @@index([asignacionId, activo, fechaDesde])
  @@index([usuarioId, activo])
  @@map("campo_backups")
}

model TareaCampo {
  id                 Int                 @id @default(autoincrement())
  empresaId          Int                 @map("empresa_id")
  empresa            Empresa             @relation(fields: [empresaId], references: [id])
  nombre             String              @db.VarChar(120)
  descripcion        String              @default("") @db.VarChar(1000)
  todosLocales       Boolean             @default(true) @map("todos_locales")
  fechaDesde         DateTime            @map("fecha_desde") @db.Date
  fechaHasta         DateTime?           @map("fecha_hasta") @db.Date
  activo             Boolean             @default(true)
  requiereFotos      Boolean             @default(false) @map("requiere_fotos")
  fotosObligatorias  Boolean             @default(false) @map("fotos_obligatorias")
  categoria          String              @default("Relevamiento") @db.VarChar(60)
  estado             EstadoTareaCampo    @default(ABIERTA)
  esObligatoria      Boolean             @default(false) @map("es_obligatoria")
  locales            TareaLocalCampo[]
  cumplimientos      CumplimientoCampo[]
  novedades          NovedadCampo[]

  @@index([empresaId, activo, fechaDesde])
  @@map("campo_tareas")
}

model TareaLocalCampo {
  tareaId Int        @map("tarea_id")
  tarea   TareaCampo @relation(fields: [tareaId], references: [id])
  localId Int        @map("local_id")
  local   LocalCampo @relation(fields: [localId], references: [id])

  @@id([tareaId, localId])
  @@index([localId])
  @@map("campo_tarea_locales")
}

model VisitaCampo {
  id                   Int                       @id @default(autoincrement())
  localId              Int                       @map("local_id")
  local                LocalCampo                @relation(fields: [localId], references: [id])
  asignacionId         Int                       @map("asignacion_id")
  asignacion           AsignacionCampo           @relation(fields: [asignacionId], references: [id])
  usuarioId            Int                       @map("usuario_id")
  usuario              Usuario                   @relation(fields: [usuarioId], references: [id])
  horarioId            Int?                      @map("horario_id")
  horario              HorarioCampo?             @relation(fields: [horarioId], references: [id])
  fecha                DateTime                  @db.Date
  entrada              DateTime                  @default(now())
  salida               DateTime?
  esBackup             Boolean                   @default(false) @map("es_backup")
  entradaLat           Float?                    @map("entrada_lat")
  entradaLng           Float?                    @map("entrada_lng")
  salidaLat            Float?                    @map("salida_lat")
  salidaLng            Float?                    @map("salida_lng")
  origen               String                    @default("COMERCIA") @db.VarChar(16)
  ucheckJornadaId      Int?                      @unique @map("ucheck_jornada_id")
  entradaPrecision     Float?                    @map("entrada_precision")
  entradaDistancia     Float?                    @map("entrada_distancia")
  entradaFueraHorario  Boolean?                  @map("entrada_fuera_horario")
  entradaFueraAtencion Boolean?                  @map("entrada_fuera_atencion")
  salidaPrecision      Float?                    @map("salida_precision")
  salidaDistancia      Float?                    @map("salida_distancia")
  salidaFueraHorario   Boolean?                  @map("salida_fuera_horario")
  salidaFueraAtencion  Boolean?                  @map("salida_fuera_atencion")
  notaEntrada          String                    @default("") @map("nota_entrada") @db.VarChar(250)
  notaSalida           String                    @default("") @map("nota_salida") @db.VarChar(250)
  cumplimientos        CumplimientoCampo[]
  novedades            NovedadCampo[]
  eventosUcheck        IntegracionUcheckEvento[]

  @@unique([asignacionId, horarioId, fecha])
  @@index([usuarioId, fecha])
  @@index([localId, fecha])
  @@map("campo_visitas")
}

enum TipoEventoUcheck {
  ENTRADA
  SALIDA
}

// Registro inmutable e idempotente recibido desde UCHECK. VisitaCampo conserva
// el estado operativo; este modelo conserva el detalle probatorio del celular.
model IntegracionUcheckEvento {
  id                  String           @id @db.VarChar(80)
  tipo                TipoEventoUcheck
  ucheckJornadaId     Int              @map("ucheck_jornada_id")
  usuarioId           Int              @map("usuario_id")
  usuario             Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  empresaId           Int              @map("empresa_id")
  empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  visitaId            Int              @map("visita_id")
  visita              VisitaCampo      @relation(fields: [visitaId], references: [id], onDelete: Restrict)
  localId             Int              @map("local_id")
  local               LocalCampo       @relation(fields: [localId], references: [id], onDelete: Restrict)
  asignacionId        Int              @map("asignacion_id")
  asignacion          AsignacionCampo  @relation(fields: [asignacionId], references: [id], onDelete: Restrict)
  horarioId           Int?             @map("horario_id")
  horario             HorarioCampo?    @relation(fields: [horarioId], references: [id], onDelete: Restrict)
  correoUsuario       String           @map("correo_usuario") @db.VarChar(254)
  registradaEn        DateTime         @map("registrada_en")
  capturadaEn         DateTime         @map("capturada_en")
  recibidaEn          DateTime         @default(now()) @map("recibida_en")
  latitud             Float
  longitud            Float
  precisionMetros     Float            @map("precision_metros")
  distanciaMetros     Float            @map("distancia_metros")
  centroLatitud       Float            @map("centro_latitud")
  centroLongitud      Float            @map("centro_longitud")
  radioMetros         Int              @map("radio_metros")
  horaDesde           String?          @map("hora_desde") @db.VarChar(5)
  horaHasta           String?          @map("hora_hasta") @db.VarChar(5)
  fueraHorario        Boolean          @map("fuera_horario")
  fueraAtencion       Boolean          @map("fuera_atencion")
  ubicacionSimulada   Boolean          @map("ubicacion_simulada")
  contextoDispositivo Json?            @map("contexto_dispositivo")

  @@unique([ucheckJornadaId, tipo])
  @@index([empresaId, registradaEn(sort: Desc)])
  @@index([usuarioId, registradaEn(sort: Desc)])
  @@map("integracion_ucheck_eventos")
}

model CumplimientoCampo {
  visitaId        Int                    @map("visita_id")
  visita          VisitaCampo            @relation(fields: [visitaId], references: [id])
  tareaId         Int                    @map("tarea_id")
  tarea           TareaCampo             @relation(fields: [tareaId], references: [id])
  nombreTarea     String                 @map("nombre_tarea") @db.VarChar(120)
  // Null mientras se adjuntan evidencias; se completa explícitamente después.
  completadaAt    DateTime?              @default(now()) @map("completada_at")
  fotosValidadas  Boolean                @default(true) @map("fotos_validadas")
  comentarios     ComentarioTareaCampo[]
  fotos           FotoTareaCampo[]

  @@id([visitaId, tareaId])
  @@map("campo_cumplimientos")
}

enum TipoNotificacionCampo {
  COMENTARIO_TAREA
  TAREA_COMPLETADA
  FOTO_SUBIDA
  NOVEDAD_CREADA
  NOVEDAD_ACTUALIZADA
  AVISO_RECIBIDO
}

enum MomentoFotoCampo {
  ANTES
  DESPUES
}

model ComentarioTareaCampo {
  id                   Int               @id @default(autoincrement())
  cumplimientoVisitaId Int               @map("cumplimiento_visita_id")
  cumplimientoTareaId  Int               @map("cumplimiento_tarea_id")
  cumplimiento         CumplimientoCampo @relation(fields: [cumplimientoVisitaId, cumplimientoTareaId], references: [visitaId, tareaId], onDelete: Cascade)
  usuarioId            Int               @map("usuario_id")
  usuario              Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  comentario           String            @db.VarChar(500)
  creadoAt             DateTime          @default(now()) @map("creado_at")
  leidoPorLider        Boolean           @default(false) @map("leido_por_lider")
  leidoAt              DateTime?         @map("leido_at")

  @@index([cumplimientoVisitaId, cumplimientoTareaId])
  @@index([usuarioId])
  @@index([leidoPorLider, creadoAt])
  @@map("campo_tarea_comentarios")
}

model FotoTareaCampo {
  id                   Int               @id @default(autoincrement())
  cumplimientoVisitaId Int               @map("cumplimiento_visita_id")
  cumplimientoTareaId  Int               @map("cumplimiento_tarea_id")
  cumplimiento         CumplimientoCampo @relation(fields: [cumplimientoVisitaId, cumplimientoTareaId], references: [visitaId, tareaId], onDelete: Cascade)
  usuarioId            Int               @map("usuario_id")
  usuario              Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  momento              MomentoFotoCampo
  rutaArchivo          String            @map("ruta_archivo") @db.VarChar(500)
  mimeType             String            @map("mime_type") @db.VarChar(50)
  tamanioBytes         Int               @map("tamanio_bytes")
  creadoAt             DateTime          @default(now()) @map("creado_at")

  @@unique([cumplimientoVisitaId, cumplimientoTareaId, momento])
  @@index([cumplimientoVisitaId, cumplimientoTareaId])
  @@index([usuarioId])
  @@map("campo_tarea_fotos")
}

model NotificacionCampo {
  id                    Int                      @id @default(autoincrement())
  empresaId             Int                      @map("empresa_id")
  empresa               Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioDestinatarioId Int                      @map("usuario_destinatario_id")
  usuarioDestinatario   Usuario                  @relation("NotificacionesRecibidas", fields: [usuarioDestinatarioId], references: [id], onDelete: Cascade)
  usuarioEmisorId       Int                      @map("usuario_emisor_id")
  usuarioEmisor         Usuario                  @relation("NotificacionesEnviadas", fields: [usuarioEmisorId], references: [id], onDelete: Cascade)
  tipo                  TipoNotificacionCampo
  referenciaId          Int?                     @map("referencia_id")
  titulo                String                   @db.VarChar(100)
  mensaje               String                   @db.VarChar(250)
  creadoAt              DateTime                 @default(now()) @map("creado_at")
  leido                 Boolean                  @default(false)
  leidoAt               DateTime?                @map("leido_at")

  @@index([usuarioDestinatarioId, leido, creadoAt(sort: Desc)])
  @@index([empresaId, creadoAt(sort: Desc)])
  @@index([tipo, referenciaId])
  @@map("campo_notificaciones")
}

enum EstadoTareaCampo {
  ABIERTA
  CERRADA
  CANCELADA
}

enum TipoNovedadCampo {
  RECLAMO
  CONSULTA
  SUGERENCIA
  INCIDENCIA
}

enum EstadoNovedadCampo {
  ABIERTA
  CERRADA
  CANCELADA
}

enum PrioridadNovedadCampo {
  NORMAL
  ALTA
  CRITICA
}

model NovedadCampo {
  id           Int                   @id @default(autoincrement())
  empresaId    Int                   @map("empresa_id")
  empresa      Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId    Int                   @map("usuario_id")
  usuario      Usuario               @relation("NovedadesReportadas", fields: [usuarioId], references: [id], onDelete: Restrict)
  localId      Int                   @map("local_id")
  local        LocalCampo            @relation(fields: [localId], references: [id], onDelete: Cascade)
  visitaId     Int?                  @map("visita_id")
  visita       VisitaCampo?          @relation(fields: [visitaId], references: [id], onDelete: SetNull)
  tareaId      Int?                  @map("tarea_id")
  tarea        TareaCampo?           @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  tipo         TipoNovedadCampo      @default(INCIDENCIA)
  estado       EstadoNovedadCampo    @default(ABIERTA)
  prioridad    PrioridadNovedadCampo @default(NORMAL)
  titulo       String                @db.VarChar(120)
  descripcion  String                @db.VarChar(1000)
  resolucion   String?               @db.VarChar(1000)
  cerradoPorId Int?                  @map("cerrado_por_id")
  cerradoPor   Usuario?              @relation("NovedadesCerradas", fields: [cerradoPorId], references: [id], onDelete: SetNull)
  cerradoAt    DateTime?             @map("cerrado_at")
  creadoAt     DateTime              @default(now()) @map("creado_at")
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at")

  @@index([empresaId, estado, creadoAt(sort: Desc)])
  @@index([usuarioId, estado])
  @@index([localId, estado])
  @@index([tareaId])
  @@map("campo_novedades")
}

enum TipoAvisoCampo {
  INDIVIDUAL
  EQUIPO
}

model AvisoCampo {
  id             Int                 @id @default(autoincrement())
  empresaId      Int                 @map("empresa_id")
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  emisorId       Int                 @map("emisor_id")
  emisor         Usuario             @relation("AvisosEnviados", fields: [emisorId], references: [id], onDelete: Restrict)
  tipo           TipoAvisoCampo      @default(EQUIPO)
  destinatarioId Int?                @map("destinatario_id")
  destinatario   Usuario?            @relation("AvisosRecibidos", fields: [destinatarioId], references: [id], onDelete: Cascade)
  mensaje        String              @db.VarChar(1000)
  creadoAt       DateTime            @default(now()) @map("creado_at")
  lecturas       AvisoLecturaCampo[]

  @@index([empresaId, creadoAt(sort: Desc)])
  @@index([emisorId, creadoAt(sort: Desc)])
  @@index([destinatarioId, creadoAt(sort: Desc)])
  @@map("campo_avisos")
}

model AvisoLecturaCampo {
  id        Int        @id @default(autoincrement())
  avisoId   Int        @map("aviso_id")
  aviso     AvisoCampo @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  usuarioId Int        @map("usuario_id")
  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  leidoAt   DateTime   @default(now()) @map("leido_at")

  @@unique([avisoId, usuarioId])
  @@index([usuarioId])
  @@map("campo_aviso_lecturas")
}
