# Plantilla del .env de PRODUCCIÓN.
# En el servidor: copiar a /opt/comercia/.env y completar.
# NUNCA commitear el .env real.

# Dominio público. Con dominio real Caddy emite HTTPS solo.
# Si todavía no hay dominio, usar ":80" y entrar por http://IP-del-servidor
DOMAIN=tudominio.com

# Base de datos. POSTGRES_PASSWORD queda vacío a propósito: el stack se niega
# a arrancar hasta que pongas una contraseña (generarla con: openssl rand -hex 32)
POSTGRES_USER=comercia
POSTGRES_PASSWORD=
POSTGRES_DB=comercia

# URLs públicas (mismo dominio: el front y la API comparten origen vía Caddy)
FRONTEND_URL=https://tudominio.com
CORS_ORIGINS=https://tudominio.com

# Secreto de cookies, vacío a propósito (generar con: openssl rand -hex 32)
COOKIE_SECRET=

# Integración server-to-server con UCHECK. Debe ser exactamente el mismo valor
# configurado como COMERCIA_INTEGRATION_SECRET en el servidor de UCHECK.
UCHECK_INTEGRATION_SECRET=

# SSO desde el APK. La URL debe incluir /api/v1 y el secreto debe coincidir con
# COMERCIA_SSO_SECRET en UCHECK, pero ser distinto al secreto de integración.
UCHECK_API_URL=https://api.universalcheck.pro/api/v1
UCHECK_SSO_SECRET=

# Documentacion /api/docs publica, sin sesion. Los endpoints mantienen sus permisos.
SWAGGER_ENABLED=true

# Tamaño máximo del cuerpo en la carga masiva de productos del catálogo (1-256 MiB).
HTTP_BODY_LIMIT_MB=50
# Tamaño máximo del cuerpo JSON y urlencoded en el resto de la API (1-50 MiB).
HTTP_BODY_LIMIT_GENERAL_MB=1

# Login automático de la app Android por número de SIM. El número lo informa el
# teléfono y no prueba identidad: con true, quien conozca el celular de un
# usuario puede entrar como él. Dejar en false salvo una urgencia temporal.
LOGIN_SIM_HABILITADO=false

# Días que se guardan las fotos de tareas. 0 = nunca se borran (por defecto).
# Con un valor (mínimo 90) la API borra cada día las fotos más antiguas.
# El borrado no se puede deshacer salvo desde un backup.
FOTOS_RETENCION_DIAS=0

# Rate limiting (opcional, valores por defecto razonables)
# Con sesión válida el límite es por usuario; sin sesión (login), por IP.
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100
# IP real detrás de Caddy u otro proxy (sintaxis "trust proxy" de Express).
# Vacío: desactivado. "loopback, linklocal, uniquelocal" confía en direcciones
# privadas (Caddy en Docker): quien llegue directo al puerto de la API desde
# la red interna podría falsear su IP en los endpoints sin sesión.
# TRUST_PROXY=

# Tags de imagen: "latest" para lo último; un SHA de commit para rollback.
API_TAG=latest
WEB_TAG=latest
