# Plantilla del .env de PRODUCCIÓN.
# En el servidor: copiar a /opt/comercia/.env y completar.
# NUNCA commitear el .env real.

# Dominio público. Con dominio real Caddy emite HTTPS solo.
# Si todavía no hay dominio, usar ":80" y entrar por http://IP-del-servidor
DOMAIN=tudominio.com

# Base de datos. POSTGRES_PASSWORD queda vacío a propósito: el stack se niega
# a arrancar hasta que pongas una contraseña (generarla con: openssl rand -hex 32)
POSTGRES_USER=comercia
POSTGRES_PASSWORD=
POSTGRES_DB=comercia

# URLs públicas (mismo dominio: el front y la API comparten origen vía Caddy)
FRONTEND_URL=https://tudominio.com
CORS_ORIGINS=https://tudominio.com

# Secreto de cookies, vacío a propósito (generar con: openssl rand -hex 32)
COOKIE_SECRET=

# Integración server-to-server con UCHECK. Debe ser exactamente el mismo valor
# configurado como COMERCIA_INTEGRATION_SECRET en el servidor de UCHECK.
UCHECK_INTEGRATION_SECRET=

# Swagger apagado en producción (encender solo para depurar)
SWAGGER_ENABLED=false

# Rate limiting (opcional, valores por defecto razonables)
# THROTTLE_TTL=60000
# THROTTLE_LIMIT=100

# Tags de imagen: "latest" para lo último; un SHA de commit para rollback.
API_TAG=latest
WEB_TAG=latest
