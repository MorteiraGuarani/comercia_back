# Configuración LOCAL para ejecutar NestJS y Next.js contra PostgreSQL de producción.
# Copiar como .env.production.local y completar DATABASE_URL con las credenciales
# productivas. Este archivo está ignorado por Git y nunca debe compartirse.
#
# npm run prod abre el túnel SSH: localhost:5435 -> comercia:5432.
# Por seguridad DATABASE_URL debe usar localhost:5435, nunca una IP pública.

NODE_ENV=development
# Puerto de NestJS local. Next.js busca un puerto libre desde 3000.
PORT=3001
# Opcional: fijar el puerto de Next.js. Si se omite, evita puertos ocupados.
# COMERCIA_WEB_PORT=3002
DATABASE_URL="postgresql://USUARIO_PRODUCCION:CONTRASENA_PRODUCCION@127.0.0.1:5435/comercia?schema=public"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
SWAGGER_ENABLED=false

# Secreto local: no reutilizar COOKIE_SECRET de producción.
COOKIE_SECRET="cambia-este-secreto-local-por-uno-largo-y-aleatorio"

# Confirmación explícita: la API local tendrá permisos de lectura Y escritura
# sobre la base de producción.
COMERCIA_PRODUCTION_DB_CONFIRMATION="SI_ENTIENDO_QUE_ES_PRODUCCION"

# Puerto local del túnel SSH. Debe coincidir con DATABASE_URL.
PROD_TUNNEL_PORT=5435

# Acceso SSH al servidor que aloja PostgreSQL de producción.
PROD_SSH_HOST=172.19.0.140
PROD_SSH_USER=root
PROD_SSH_PORT=22
