# Plantilla opcional de overrides locales.
# El entorno que usan los comandos de desarrollo vive en .env.development.

# --- API (NestJS) ---
NODE_ENV=development
PORT=3002
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/comercia?schema=public"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
SWAGGER_ENABLED=true

# Secreto compartido exclusivamente entre las APIs de UCHECK y Comercia.
# Generá uno aleatorio de 32+ caracteres y no lo expongas al navegador ni al APK.
UCHECK_INTEGRATION_SECRET=replace-with-the-same-random-secret-in-ucheck
# URL base de la API de UCHECK, incluyendo /api/v1, para canjear tickets SSO.
UCHECK_API_URL=http://localhost:3001/api/v1
# Opcional durante pruebas: si se omite, usa UCHECK_INTEGRATION_SECRET. En
# producción conviene configurar un secreto distinto y coincidente en UCHECK.
UCHECK_SSO_SECRET=replace-with-a-different-random-sso-secret
COOKIE_SECRET="change-this-secret-before-production-please-use-64-random-chars"

# --- PostgreSQL de desarrollo ---
# Debe coincidir con el puerto de DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=comercia
POSTGRES_PORT=5434
