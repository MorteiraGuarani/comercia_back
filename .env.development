# Entorno local versionado y sin secretos de producción.
# Los comandos npm de desarrollo usan siempre este archivo.
NODE_ENV=development
PORT=3002
DATABASE_URL="postgresql://postgres:1234@localhost:5433/comercia?schema=public"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
SWAGGER_ENABLED=true
COOKIE_SECRET="development-only-cookie-secret-not-for-production-2026"

# PostgreSQL local de Docker. El puerto 5433 evita interferir con otros proyectos.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB=comercia
POSTGRES_PORT=5433
